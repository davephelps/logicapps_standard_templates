        }
      },
      "parameterSetName": "ManagedServiceIdentity",
      "serviceProvider": {
        "id": "/serviceProviders/AzureFile"
      },
      "displayName": "AzureFile_Connection"
    },
    "eventHub": {
      "parameterValues": {
        "fullyQualifiedNamespace": "@appsetting('eventHub_fullyQualifiedNamespace')",
        "authProvider": {
          "Type": "ManagedServiceIdentity"
        }
      },
      "parameterSetName": "ManagedServiceIdentity",
      "serviceProvider": {
        "id": "/serviceProviders/eventHub"
      },
      "displayName": "EventHub_Connection"
    },
    "eventGridPublisher": {
      "parameterValues": {
        "topicEndpoint": "@appsetting('eventGridPublisher_topicEndpoint')",
        "authProvider": {
          "Type": "ManagedServiceIdentity"
        }
      },
      "parameterSetName": "ManagedServiceIdentity",
      "serviceProvider": {
        "id": "/serviceProviders/eventGridPublisher"
      },
      "displayName": "EventGridPublisher_Connection"
