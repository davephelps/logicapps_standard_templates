{
  "serviceProviderConnections": {
    "serviceBus": {
      "parameterValues": {
        "connectionString": "@appsetting('serviceBus_connectionString')"
      },
      "parameterSetName": "connectionString",
      "serviceProvider": {
        "id": "/serviceProviders/serviceBus"
      },
      "displayName": "ServiceBus_Connection"
    },
    "AzureBlob": {
      "parameterValues": {
        "connectionString": "@appsetting('AzureBlob_connectionString')"
      },
      "parameterSetName": "connectionString",
      "serviceProvider": {
        "id": "/serviceProviders/AzureBlob"
      },
      "displayName": "AzureBlob_Connection"
    },
    "azureTables": {
      "parameterValues": {
        "connectionString": "@appsetting('azureTables_connectionString')"
      },
      "parameterSetName": "connectionString",
      "serviceProvider": {
        "id": "/serviceProviders/azureTables"
      },
      "displayName": "AzureTables_Connection"
    },
    "azurequeues": {
      "parameterValues": {
        "connectionString": "@appsetting('azurequeues_connectionString')"
      },
      "parameterSetName": "connectionString",
      "serviceProvider": {
        "id": "/serviceProviders/azurequeues"
      },
      "displayName": "AzureQueues_Connection"
    },
    "sftp": {
      "parameterValues": {
        "sshHostAddress": "@appsetting('sftp_sshHostAddress')",
        "portNumber":     "@appsetting('sftp_portNumber')",
        "userName":       "@appsetting('sftp_userName')",
        "password":       "@appsetting('sftp_password')"
      },
      "serviceProvider": {
        "id": "/serviceProviders/Sftp"
      },
      "displayName": "Sftp_Connection"
    },
    "ftp": {
      "parameterValues": {
        "serverAddress": "@appsetting('ftp_serverAddress')",
        "portNumber":    21,
        "userName":      "@appsetting('ftp_userName')",
        "password":      "@appsetting('ftp_password')"
      },
      "serviceProvider": {
        "id": "/serviceProviders/Ftp"
      },
      "displayName": "Ftp_Connection"
    },
    "sql": {
      "parameterValues": {
        "connectionString": "@appsetting('sql_connectionString')"
      },
      "parameterSetName": "connectionString",
      "serviceProvider": {
        "id": "/serviceProviders/sql"
      },
      "displayName": "Sql_Connection"
    }
  },
  "managedApiConnections": {}
