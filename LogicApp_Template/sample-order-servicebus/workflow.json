{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "actions": {
            "Call_External_API": {
                "type": "Http",
                "inputs": {
                    "uri": "@appsetting('externalApiUrl')",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json",
                        "X-Correlation-Id": "@guid()"
                    },
                    "body": "@triggerBody()"
                },
                "runAfter": {},
                "description": "Calls an external HTTP API. In integration tests the externalApiUrl app setting is patched to the WireMock base URL."
            },
            "Publish_To_Service_Bus": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "entityName": "sample-queue",
                        "message": {
                            "contentData": "@body('Call_External_API')",
                            "contentType": "application/json"
                        }
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "serviceBus",
                        "operationId": "sendMessage",
                        "serviceProviderId": "/serviceProviders/serviceBus"
                    }
                },
                "runAfter": {
                    "Call_External_API": [
                        "SUCCEEDED"
                    ]
                },
                "description": "Publishes the enriched order to a Service Bus queue. In integration tests serviceBus_connectionString is patched to the Service Bus emulator."
            },
            "Return_Response": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200,
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": "@body('Call_External_API')"
                },
                "runAfter": {
                    "Publish_To_Service_Bus": [
                        "SUCCEEDED"
                    ]
                }
            }
        },
        "outputs": {},
        "triggers": {
            "When_a_HTTP_request_is_received": {
                "type": "Request",
                "kind": "Http",
                "description": "Sample workflow used by the integration test harness: HTTP in -> external HTTP call -> Service Bus publish -> HTTP response."
            }
        }
    },
    "kind": "Stateful"
}
